{
  "version": 1,
  "sources": {
    "personal": {"provider": "local", "location": "customizations", "style": "portable"},
    "public": {"provider": "git", "location": "https://github.com/example/customizations.git", "select": ["skills/*"], "options": {"ref": "main"}},
    "claude-native": {"location": "native-claude", "style": "claude"}
  },
  "destinations": {
    "shared": {"location": "~/.agents", "profile": "shared", "enabled": true},
    "claude": {"location": "~/.claude", "profile": "claude", "enabled": true},
    "archive": {"location": "exports", "enabled": true},
    "vscode-project": {"location": "project/.github", "profile": "copilot-vscode", "scope": "project", "enabled": false}
  },
  "pipelines": {
    "public-prefix": [{"use": "prefix", "options": {"remove": "old-", "add": "shared-"}}]
  },
  "routes": [
    {"name": "skills", "sources": ["personal"], "destinations": ["shared", "claude"], "select": ["skills/*"]},
    {"name": "public-skills", "sources": ["public"], "destinations": ["shared"], "steps": ["public-prefix"]},
    {"name": "claude-customizations", "sources": ["personal", "claude-native"], "destinations": ["claude"], "select": ["instructions/*", "agents/*", "prompts/*", "mcp/*", "hooks/*"]},
    {"name": "archive", "sources": ["personal"], "destinations": ["archive"]},
    {"name": "claude-to-vscode", "sources": ["claude-native"], "destinations": ["vscode-project"], "select": ["agents/*", "prompts/*"], "allow_approximate": true, "unsupported": "exclude"}
  ],
  "settings": {"debounce": 0.5, "poll": 60, "verify": 300, "remote_poll": 300}
}
