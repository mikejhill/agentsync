{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:skillsinc:configuration:1",
  "title": "SkillSinc orchestration envelope v1",
  "type": "object",
  "required": ["version"],
  "properties": {
    "version": {"const": 1},
    "sources": {"type": "object", "additionalProperties": {"$ref": "#/$defs/source"}},
    "destinations": {"type": "object", "additionalProperties": {"$ref": "#/$defs/destination"}},
    "routes": {"type": "array", "items": {"$ref": "#/$defs/route"}},
    "pipelines": {"type": "object", "additionalProperties": {"$ref": "#/$defs/steps"}},
    "settings": {"type": "object", "properties": {
      "debounce": {"type": "number", "exclusiveMinimum": 0},
      "poll": {"type": "number", "exclusiveMinimum": 0},
      "verify": {"type": "number", "exclusiveMinimum": 0},
      "remote_poll": {"type": "number", "exclusiveMinimum": 0}
    }, "additionalProperties": true}
  },
  "additionalProperties": true,
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}},
    "step": {"type": "object", "required": ["use"], "properties": {
      "use": {"type": "string"}, "options": {"type": "object"}
    }, "additionalProperties": true},
    "steps": {"type": "array", "items": {"oneOf": [
      {"type": "string"}, {"$ref": "#/$defs/step"}
    ]}},
    "source": {"type": "object", "required": ["location"], "properties": {
      "location": {"type": "string"}, "provider": {"type": "string", "default": "local"},
      "reader": {"type": "string", "default": "default"}, "style": {"type": "string", "default": "portable"},
      "select": {"$ref": "#/$defs/strings"}, "options": {"type": "object"}
    }, "additionalProperties": true},
    "destination": {"type": "object", "required": ["location"], "properties": {
      "location": {"type": "string"}, "profile": {"type": "string", "default": "generic"},
      "enabled": {"type": "boolean", "default": false}, "scope": {"enum": ["user", "project"]},
      "version": {"type": "string"}, "options": {"type": "object"}
    }, "additionalProperties": true},
    "route": {"type": "object", "required": ["name", "sources", "destinations"], "properties": {
      "name": {"type": "string"}, "sources": {"$ref": "#/$defs/strings"},
      "destinations": {"$ref": "#/$defs/strings"}, "select": {"$ref": "#/$defs/strings"},
      "steps": {"$ref": "#/$defs/steps"}, "allow_approximate": {"type": "boolean", "default": false},
      "unsupported": {"enum": ["block", "exclude"], "default": "block"}
    }, "additionalProperties": true}
  }
}
